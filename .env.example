# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Optional: LLM Gateway model for scripts. Default qwen3.5-4b-32k-fast (free tier);
# better ones unlock once billing is enabled.
# LLM_MODEL=gemini-2.5-flash

# Optional: total characters read from all sources per episode (default 24000).
# SOURCE_CHAR_LIMIT=40000

# Optional: raises the GitHub API limit (repo metadata + file lists) from 60 to 5000 requests/hour.
# GITHUB_TOKEN=
